# The naming sheet filled and confirmed with the app in the background (DM_TEST_BGRUN=1: the game window is never key, the app never active): fe `type` must
# reach the sheet's text field and fe `key 36` (Return) must confirm the sheet, as a player's typing would, and the new character "Bgrun" is created.
# The sheet takes the key state as in front: an emulated `app state=resign cause=sheet` when it begins, `active` when it ends
name bg_sheet_mac
requires mac-app
save warlock
timeout 180
env DM_TEST_BGRUN=1

expect main_menu timeout=120
sleep 1
press PLUS
sleep 1
press DOWN
press A
expect_state panels~=CharacterCreatePanel timeout=20
sleep 1.5
press A
expect_state panels~=CharacterOptionsPanel timeout=10
sleep 1
press A
expect_state focus_panel=CharacterCreateNamePanel focus=InputText timeout=10
sleep 1
fe "0 skey 36"
sleep 2
fe "0 type Bgrun"
sleep 1
fe "0 key 36"
sleep 2
expect sheet result=ok len=5 timeout=5
expect_state focus_panel=CharacterCreateNamePanel timeout=5
press PLUS
expect game_enter timeout=60
expect loading_done timeout=120
expect_state in_game=true level=1 dead=false timeout=20
save_now timeout=8
quit
check event app state=resign cause=sheet emu=true
check no_event desk what=front by=self
check no_red
check no_red_log
