# PC mode with an NPC and the game menu (dm_kbm.c, dm_world.c dm_world_pc_click), on the Mac App test copy at this Mac's Recommended in full
# screen. A real mouse click on Kashya opens her dialog (the PC left press on an NPC used to walk up without talking); Return over her speech
# opens no chat (the chat used to freeze the speech); Esc goes back through the speech, then her menu; in the Esc game menu a mouse click on
# Options opens it (a press the hit test can't place used to go to the world). pc_npc_mac_1610.scn runs the same on a fake MacBook Neo (16:10)
name pc_npc_mac
requires mac-app
save warlock
timeout 600
env DM_PC_MODE=1 DM_TEST_VIDEO_FIRSTBOOT=1 DM_TEST_WORLD_GO=near:1:c150@150

expect main_menu timeout=120
enter_game
# DM_TEST_WORLD_GO walks the hero near Kashya (within 4 cells, no talking) from tick 150
sleep 16
fe "0 hover 640,330"
sleep 1
fe "0 unit 1,150"
expect panel act=OpenPanel name=NpcDialogPanel timeout=20
expect panel act=OpenPanel name=ScrollSpeechPanel timeout=5
sleep 1.5
screenshot path=npc_speech.png
# Return over the speech: nothing
fe "0 key 36"
sleep 1
fe "0 key 53"
expect panel act=ClosePanel name=ScrollSpeechPanel timeout=5
sleep 1
screenshot path=npc_menu.png
fe "0 key 53"
expect panel act=ClosePanel name=NpcDialogPanel timeout=5
sleep 1
# the game menu, a mouse click on Options (interface 0.5, 0.406)
fe "0 key 53"
expect pause_open timeout=8
sleep 1
fe "0 down 640,292"
sleep 0.15
fe "0 up 640,292"
expect_state panels~=SettingsPanel timeout=5
screenshot path=options.png
fe "0 key 53"
sleep 1
fe "0 key 53"
sleep 1
quit
check no_event panel act=OpenPanel name=MessageLogPanel_800x600
check no_red
check no_red_log
