# Generates a save: a new Warlock, made on the character creation screen (the class is picked by tapping its figure), entered once and
# exported as save_ref_warlock_hero. The standard save's heroes are of another class; routes that need the Warlock's skills use this one
# (bench/skill_tour.scn). It stays in the local workspace and is never committed. Windowed in the background: the naming step goes through
# the Mac front end.
name gen_warlock_hero
requires cli
save warlock
env DM_VKBD=1
timeout 180

expect main_menu timeout=120
sleep 1
press PLUS
sleep 1
press DOWN
press A
expect_state panels~=CharacterCreatePanel timeout=20
sleep 1.5
tap_ui Warlock
sleep 1
press A
expect_state panels~=CharacterOptionsPanel timeout=10
sleep 1
press A
expect_state focus_panel=CharacterCreateNamePanel focus=InputText timeout=10
sleep 1
press A
sleep 1.5
fe "0 pads X,A,RIGHT,A,RIGHT,A"
sleep 2.5
fe "0 pad PLUS"
expect game_enter timeout=60
expect loading_done timeout=120
expect_state in_game=true level=1 dead=false timeout=20
save_now timeout=8
export_save warlock_hero overwrite=1
quit
check no_red
check no_red_log
