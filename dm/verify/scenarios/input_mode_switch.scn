# 只在会切布局的前端上跑：Mac App 一直是手柄版、从不切 | only on front ends that switch layouts: the Mac App always runs the controller layout and never switches
# Switching the controller / touch layout and the key cap style during a run (plus the key caps): every switch must finish (padmode event) with no rebuild that needed the timeout, ticks keep running, the pause page opens and closes, no red markers
name input_mode_switch
requires cli ios-mac
save warlock
env DM_ROMFS_OVERLAY=auto
timeout 240

enter_game
inputmode mode=controller
expect padmode mode=controller timeouts=0 timeout=20
remember tick
sleep 1
expect_state tick>=$tick+10 in_game=true
open_pause
close_pause
inputmode glyph=xbox
expect padmode glyph=Xbox timeouts=0 timeout=20
inputmode glyph=playstation
expect padmode glyph=PlayStation timeouts=0 timeout=20
inputmode glyph=switch
expect padmode glyph=Switch timeouts=0 timeout=20
inputmode mode=touch
expect padmode mode=touch timeouts=0 timeout=20
stick 1 0 frames=30
remember tick
sleep 1
expect_state tick>=$tick+10 in_game=true dead=false
quit
check no_red
check no_red_log
