# Upscaling = MetalFX Temporal through the Video tab, live (dm_video.c dm_video_temporal_active, nvn_mv.inc): the controller sets 3D Resolution to 75% and Upscaling to
# its third option, Apply starts the temporal scaler from the next frame with no restart (the game's own anti-aliasing off, its Halton jitter on: the log lines prove
# each), and stepping back to MetalFX puts it down again. Starts from this Mac's Recommended, as a player does; rows: mode, res, color, preset, s3d, upscale
name video_temporal_mac
requires mac-app
save warlock
env DM_TEST_VIDEO_FIRSTBOOT=1
timeout 240

enter_game
sleep 3
open_pause
tap_ui Settings
sleep 2
inputmode mode=controller
sleep 1
press DOWN
press DOWN
press DOWN
press DOWN
press RIGHT
sleep 0.5
press RIGHT
sleep 0.5
press DOWN
press RIGHT
sleep 1
screenshot video_temporal.png
msg OptionsPanelMessage:AcceptChanges
sleep 6
screenshot temporal_on.png
press LEFT
sleep 1
msg OptionsPanelMessage:AcceptChanges
sleep 3
quit
check event video_row row=upscale value=2
check event picture how=apply up=2
check log_has "temporal scaler: wanted"
check log_has "temporal scaler: .* built in"
check log_has "temporal scaler: camera jitter seen"
check log_has "temporal scaler: no longer wanted"
check event picture how=apply up=1
check no_red
check no_red_log
