# MetalFX Temporal (dm/tools/picture.py REC75T): the 3D at 75%. The scaler builds in the background and takes the 3D pass (nvn_mv.inc), the game's own
# anti-aliasing is off with it, the camera jitters (the game's Halton mode through the rewriter's KJITTER slot) and there is no second MetalFX at the present
name pic_rec75t
requires cli
save warlock
timeout 180
env DM_3D_SCALE=0.75 DM_MFXT=1 DM_GAME_RES=2560x1440 DM_MFX=1 DM_MFX3D=1 DM_AA_MODE=0 DM_NVN_ANISO=16 DM_COLORSPACE=srgb DM_ENV_SHADOWS=1 DM_SHADOW_SIZE=4096 DM_3D_SCALE_DYN=0 DM_GAME_SEED=305419896

enter_game
expect_state in_game=true hp>=1 area=1 timeout=10
sleep 6
expect_mem main+0x31e0848 4 chain=0x66a4 hex=0000403f
expect_mem main+0x31e0848 1 chain=0x6614 hex=00
walk_to 5789 4470 timeout=20
quit
check no_red
check no_red_log
check exit 0
check event scale3d pct=75
check event mfx who=temporal op=build
check no_event mfx who=pres op=build
check log_has "temporal scaler: camera jitter seen"
check log_has "motion vectors: velocity target"
