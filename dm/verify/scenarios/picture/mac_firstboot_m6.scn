# The Mac App test copy's first launch on this Mac (DM_TEST_VIDEO_FIRSTBOOT=1: no settings file, the recommendation worked out from the chip and
# the screen; an M6 with a 12-core GPU on a 2560 x 1440 screen): the picture event carries the whole Recommended set (Native, MetalFX on, SMAA,
# 16x, Accurate colour, 3D 100%, environment shadows on, Ultra shadows), the renderer's AA byte is SMAA, and there is no MetalFX at the present.
# Expected values are this Mac's: another Mac's chip or screen gives another set (t_picrec_cases.h)
name pic_mac_firstboot_m6
requires mac-app
save warlock
timeout 300
env DM_TEST_VIDEO_FIRSTBOOT=1 DM_GAME_SEED=305419896

expect main_menu timeout=120
enter_game
sleep 6
expect_mem main+0x31e0848 1 chain=0x6614 hex=02
system_quit
check no_red
check no_red_log
check event picture how=first mode=1 res=3 up=1 aa=1 aniso=3 color=1 s3d=0 envsh=1 shq=2
check log_has "→ Recommended Native 2560, 3D 100%, environment shadows on, shadows Ultra, Frame Drops keep"
check no_event mfx who=pres op=build
