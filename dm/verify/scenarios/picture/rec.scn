# The conventional picture of a chip without Temporal and Frame Generation, on the CLI host (dm/tools/picture.py CONV pinned through its switches: SMAA, 16x filtering, environment shadows,
# the 4096 shadow map, 3D 100%). Filtering alternates between 16x and the original every 60 frames (DM_NVN_UB), so the sampler latch rebuilds the
# samplers both ways. Judged on the renderer's AA byte (2 = SMAA), the host's own reports and the user's choice of one MetalFX pass (no MetalFX
# at the present). No GPU timing, so fork_gate also runs it under Metal API validation (full_metal_validation_rec)
name pic_rec
requires cli
save warlock
timeout 180
env DM_3D_SCALE=1.0 DM_GAME_RES=2560x1440 DM_MFX=1 DM_MFX3D=1 DM_AA_MODE=2 DM_NVN_ANISO=16 DM_COLORSPACE=srgb DM_ENV_SHADOWS=1 DM_SHADOW_SIZE=4096 DM_3D_SCALE_DYN=0 DM_GAME_SEED=305419896 DM_NVN_UB=aniso=@set:g_aniso=0 DM_NVN_UB_N=60

enter_game
expect_state in_game=true hp>=1 area=1 timeout=10
sleep 6
expect_mem main+0x31e0848 1 chain=0x6614 hex=02
walk_to 5789 4470 timeout=20
quit
check no_red
check no_red_log
check exit 0
check log_has "Environment shadows: on \(DM_ENV_SHADOWS\)"
check log_has "Shadow map: 4096 px \(DM_SHADOW_SIZE\)"
check log_has "texture filtering: anisotropy 0 → 16"
check log_has "texture filtering: anisotropy 16 → 0" min=2
check no_event mfx who=pres op=build
